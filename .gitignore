# 测试与一次性脚本的临时产物（勿提交）
# tmp/ 目前由 sparse-checkout 排除在工作区外，这里再加一道防线：
# 测试每次运行会在这里生成 quote-ingest-*、bad-pack-* 等目录
tmp/
.pytest-*/

# Local storage placeholders
data/
uploads/
storage/

# Logs
*.log
logs/

# OnlyOffice 从 Windows 拷入的中文字体（勿提交）
infra/onlyoffice-fonts/*
!infra/onlyoffice-fonts/.gitkeep


# Alembic
# keep versions; ignore local db dumps
*.db
